         <string notr="true">QTableWidget {
    background-color: white;
    color: #222222;
    gridline-color: #cccccc;
    border: 2px solid black;
    border-radius: 10px;
    font-size: 16px;
    font-family: &quot;Arbutus Slab&quot;;
}
QTableWidget::item {
    padding: 10px 14px;
    border-bottom: 1px solid #e0e0e0;
    color: #222222;
}
QTableWidget::item:selected {
    background-color: #f2c4c3;
    color: #921913;
}
QTableWidget::item:alternate {
    background-color: #f7f7f7;
}
QHeaderView::section {
    background-color: #921913;
    color: white;
    border: none;
    border-right: 1px solid #7a100e;
    border-bottom: 3px solid #5a0c0a;
    padding: 14px 10px;
    font-size: 16px;
    font-weight: bold;
    font-family: &quot;Arbutus Slab&quot;;
}
